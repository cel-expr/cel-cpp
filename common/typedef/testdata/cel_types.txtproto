# proto-file: common/typedef/typedef.proto
# proto-message: cel.types.TypeDefSet

# Minimal struct and enum (name only)
types {
  struct_type {
    name: "MinimalStruct"
  }
}
types {
  enum_type {
    name: "MinimalEnum"
  }
}

# Struct with name and doc
types {
  struct_type {
    name: "NoFields"
    doc: "Empty struct."
  }
}

# Enum with constants and doc
types {
  enum_type {
    name: "com.example.OrderStatus"
    doc: "Order lifecycle state."
    constants { name: "UNSPECIFIED" id: 0 doc: "Default value." }
    constants { name: "PENDING" id: 1 }
    constants { name: "SHIPPED" id: 10 doc: "Shipped to customer." }
  }
}

# Struct with fields
types {
  struct_type {
    name: "com.example.store.Order"
    members {
      field {
        name: "items"
        type {
          list_type {
            elem_type {
              abstract_type { name: "com.example.store.Item" }
            }
          }
        }
      }
    }
    members {
      field {
        name: "metadata"
        type {
          map_type {
            key_type { primitive: STRING }
            value_type { dyn {} }
          }
        }
      }
    }
    members {
      field {
        name: "notes"
        type { wrapper: STRING }
      }
    }
  }
}

# Struct with oneof
types {
  struct_type {
    name: "com.example.OneofStruct"
    members {
      field {
        name: "a"
        type { primitive: STRING }
      }
    }
    members {
      oneof_type {
        fields {
          name: "b"
          type { primitive: INT64 }
          doc: "Int option."
          default_value { int64_value: 7 }
          aspects {
            key: "proto"
            value {
              properties {
                key: "id"
                value { int64_value: 2 }
              }
              properties {
                key: "json_name"
                value { string_value: "protoB" }
              }
              properties {
                key: "name"
                value { string_value: "proto_b" }
              }
            }
          }
        }
        fields {
          name: "c"
          type {
            list_type {
              elem_type { primitive: DOUBLE }
            }
          }
          aspects {
            key: "proto"
            value {}
          }
        }
      }
    }
    members {
      oneof_type {}
    }
    members {
      field {
        name: "d"
        type { well_known: DURATION }
      }
    }
  }
}

# All remaining supported field types and default constant kinds
types {
  struct_type {
    name: "AllSupportedFieldTypes"
    members {
      field {
        name: "null_field"
        type { null: NULL_VALUE }
        default_value { null_value: NULL_VALUE }
      }
    }
    members {
      field {
        name: "bool_field"
        type { primitive: BOOL }
        default_value { bool_value: true }
      }
    }
    members {
      field {
        name: "uint_field"
        type { primitive: UINT64 }
        default_value { uint64_value: 456 }
      }
    }
    members {
      field {
        name: "double_field"
        type { primitive: DOUBLE }
        default_value { double_value: 3.25 }
      }
    }
    members {
      field {
        name: "bytes_field"
        type { primitive: BYTES }
        default_value { bytes_value: "\001\002\003" }
      }
    }
    members {
      field {
        name: "string_field"
        type { primitive: STRING }
        default_value { string_value: "hello" }
      }
    }
    members {
      field {
        name: "duration_field"
        type { well_known: DURATION }
        default_value { duration_value { seconds: 10 } }
      }
    }
    members {
      field {
        name: "timestamp_field"
        type { well_known: TIMESTAMP }
        default_value { timestamp_value { seconds: 1791158400 } }
      }
    }
    members {
      field {
        name: "enum_field"
        type { abstract_type { name: "com.example.Status" } }
        default_value { string_value: "ACTIVE" }
      }
    }
    members {
      field {
        name: "any_field"
        type { well_known: ANY }
      }
    }
    members {
      field {
        name: "func_field"
        type {
          function {
            result_type { primitive: BOOL }
            arg_types { primitive: INT64 }
            arg_types { primitive: STRING }
          }
        }
      }
    }
    members {
      field {
        name: "type_param_f"
        type { type_param: "T" }
      }
    }
    members {
      field {
        name: "unspec_prim_f"
        type { primitive: PRIMITIVE_TYPE_UNSPECIFIED }
      }
    }
    members {
      field {
        name: "bool_w_f"
        type { wrapper: BOOL }
      }
    }
    members {
      field {
        name: "int_w_f"
        type { wrapper: INT64 }
      }
    }
    members {
      field {
        name: "uint_w_f"
        type { wrapper: UINT64 }
      }
    }
    members {
      field {
        name: "double_w_f"
        type { wrapper: DOUBLE }
      }
    }
    members {
      field {
        name: "bytes_w_f"
        type { wrapper: BYTES }
      }
    }
    members {
      field {
        name: "unspec_w_f"
        type { wrapper: PRIMITIVE_TYPE_UNSPECIFIED }
      }
    }
    members {
      field {
        name: "unspec_wk_f"
        type { well_known: WELL_KNOWN_TYPE_UNSPECIFIED }
      }
    }
    members {
      field {
        name: "map_val_only_f"
        type {
          map_type {
            key_type {}
            value_type { primitive: INT64 }
          }
        }
      }
    }
    members {
      field {
        name: "type_int_f"
        type {
          type { primitive: INT64 }
        }
      }
    }
    members {
      field {
        name: "type_unspec_f"
        type {
          type {}
        }
      }
    }
    members {
      field {
        name: "abstract_params_f"
        type {
          abstract_type {
            name: "MyGeneric"
            parameter_types { primitive: INT64 }
          }
        }
      }
    }
    members {
      field {
        name: "shipping_addr"
        type {
          message_type: "com.example.Address"
        }
      }
    }
    members {
      field {
        name: "error_f"
        type { error {} }
      }
    }
  }
}

# Struct and enum with aspects
types {
  struct_type {
    name: "com.example.AnnotatedOrder"
    doc: "Order with schema aspects."
    members {
      field {
        name: "order_id"
        type { primitive: STRING }
        aspects {
          key: "proto"
          value {
            properties {
              key: "id"
              value { int64_value: 1 }
            }
            properties {
              key: "json_name"
              value { string_value: "orderId" }
            }
            properties {
              key: "name"
              value { string_value: "order_id_proto" }
            }
          }
        }
      }
    }
    members {
      field {
        name: "empty_aspect_field"
        type { primitive: INT64 }
        aspects {
          key: "proto"
          value {}
        }
      }
    }
    aspects {
      key: "proto"
      value {
        properties {
          key: "name"
          value { string_value: "com.example.proto.Order" }
        }
      }
    }
  }
}
types {
  enum_type {
    name: "com.example.AnnotatedStatus"
    constants {
      name: "STATUS_ACTIVE"
      id: 1
      aspects {
        key: "proto"
        value {
          properties {
            key: "name"
            value { string_value: "ACTIVE" }
          }
        }
      }
    }
    aspects {
      key: "proto"
      value {
        properties {
          key: "allow_alias"
          value { bool_value: true }
        }
        properties {
          key: "name"
          value { string_value: "com.example.proto.Status" }
        }
      }
    }
  }
}

# Struct with typed aspect properties
types {
  struct_type {
    name: "com.example.Order"
    members {
      field {
        name: "order_id"
        type { primitive: STRING }
        aspects {
          key: "proto"
          value {
            properties {
              key: "id"
              value { int64_value: 1 }
            }
            properties {
              key: "json_name"
              value { string_value: "orderId" }
            }
          }
        }
      }
    }
    aspects {
      key: "proto"
      value {
        properties {
          key: "bool_prop"
          value { bool_value: false }
        }
        properties {
          key: "bytes_prop"
          value { bytes_value: "\001\002" }
        }
        properties {
          key: "double_prop"
          value { double_value: 2.5 }
        }
        properties {
          key: "duration_prop"
          value { duration_value { seconds: 10 } }
        }
        properties {
          key: "name"
          value { string_value: "com.example.proto.Order" }
        }
        properties {
          key: "null_prop"
          value { null_value: NULL_VALUE }
        }
        properties {
          key: "timestamp_prop"
          value { timestamp_value { seconds: 1767323045 } }
        }
        properties {
          key: "uint_prop"
          value { uint64_value: 42 }
        }
        properties {
          key: "version"
          value { int64_value: 2 }
        }
        properties {
          key: "whole_double_prop"
          value { double_value: 2 }
        }
        properties {
          key: "zero_duration_prop"
          value { duration_value {} }
        }
      }
    }
  }
}

# High-precision and special IEEE-754 double defaults
types {
  struct_type {
    name: "Floats"
    members {
      field {
        name: "pi"
        type { primitive: DOUBLE }
        default_value { double_value: 3.141592653589793 }
      }
    }
    members {
      field {
        name: "pos_inf"
        type { primitive: DOUBLE }
        default_value { double_value: inf }
      }
    }
    members {
      field {
        name: "neg_inf"
        type { primitive: DOUBLE }
        default_value { double_value: -inf }
      }
    }
  }
}
