  message_type {
    name: "Event"
    field {
      name: "created_at"
      number: 1
      label: LABEL_OPTIONAL
      type: TYPE_MESSAGE
      type_name: ".google.protobuf.Timestamp"
    }
    field {
      name: "unpacked_vals"
      number: 2
      label: LABEL_REPEATED
      type: TYPE_INT64
      options {
        packed: false
      }
    }
  }
}
file {
