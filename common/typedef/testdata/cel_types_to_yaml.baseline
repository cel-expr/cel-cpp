enum:
  name: "com.example.OrderStatus"
  doc: "Order lifecycle state."
  constants:
    - name: "UNSPECIFIED"
      id: 0
      doc: "Default value."
    - name: "PENDING"
      id: 1
    - name: "SHIPPED"
      id: 10
      doc: "Shipped to customer."
