- enum:
    name: "com.example.CustomEnum"
    doc: "Enum doc comment."
    aspects:
      proto:
        allow_alias: true
        file_name: "custom.proto"
    constants:
      - name: "UNKNOWN"
        id: 0
        doc: "Enum constant doc comment."
      - name: "FIRST"
        id: 1
      - name: "ALIAS_FIRST"
        id: 1
- struct:
    name: "com.example.CustomMsg"
    doc: "Message doc comment."
    aspects:
      proto:
        file_name: "custom.proto"
    fields:
      - name: "custom_field"
        type: "string"
        doc: "Field doc comment."
        default: "hello"
        aspects:
          proto:
            id: 1
            json_name: "customJson"
      - name: "normal_field"
        type: "int"
        aspects:
          proto:
            id: 2
            type: "int32"
      - name: "packed_ints"
        type: "list<int>"
        aspects:
          proto:
            id: 3
- struct:
    name: "com.example.EditionsMsg"
    aspects:
      proto:
        file_name: "editions_file.proto"
    fields:
      - name: "y"
        type: "int"
        aspects:
          proto:
            id: 1
- struct:
    name: "com.example.Event"
    aspects:
      proto:
        file_name: "event.proto"
    fields:
      - name: "created_at"
        type: "timestamp"
        aspects:
          proto:
            id: 1
      - name: "unpacked_vals"
        type: "list<int>"
        aspects:
          proto:
            id: 2
- enum:
    name: "com.example.NonZeroEnum"
    aspects:
      proto:
        file_name: "nonzero_enum.proto"
    constants:
      - name: "NZ_FIRST"
        id: 1
      - name: "NZ_SECOND"
        id: 2
